# Определение персонажей игры.
define marina = Character("Марина Андреевна", color="#5a2d00")
define irina = Character("Ирина Валерьевна", color="#2b0000")
define patient = Character("Пациент", color="#08005e")
define patient_f = Character("Пациентка", color="#08005e")
define nadezhda = Character("Надежда Сергеевна", color="#005ab4")
define child = Character("Ребёнок", color="#452900")
define mother = Character("Мама", color="#180000")
define relative = Character("Родственник", color="#180000")
define olga = Character("Ольга Николаевна", color="#003a00")
define elena = Character("Елена Викторовна", color="#310031")
define dmitri = Character("Дмитрий", color="#3a1f00")
define sergey = Character("Сергей", color="#1f1f3a")

default priem_score = 0
default priem_attitude = 0

default therapy_score = 0
default therapy_attitude = 0

default pediatrics_score = 0
default pediatrics_attitude = 0

default infection_score = 0
default infection_attitude = 0

default psych_score = 0
default psych_attitude = 0

default ending = ""

# Отключаем анимацию появления/скрытия окна диалога (в веб-версии из-за неё была ошибка)
define config.window_show_transition = None
define config.window_hide_transition = None

# Проверяем, проходил ли игрок игру хотя бы раз
default persistent.game_started = False
default persistent.unlocked_chapters = 1      # сколько глав открыто


# ============================================
# ЗАСТАВКА ГЛАВЫ
# ============================================

screen chapter_title(number, title):
    modal True
    add "#000000"

    vbox:
        xalign 0.5
        yalign 0.4
        spacing 25

        text "Глава [number]":
            xalign 0.5
            size 40
            color "#aaaaaa"

        text "[title]":
            xalign 0.5
            size 70
            color "#ffffff"
            text_align 0.5

    textbutton "Вернуться":
        xalign 0.05
        yalign 0.95
        text_size 36
        text_color "#aaaaaa"
        text_hover_color "#ffffff"
        action Return("back")

    textbutton "Продолжить":
        xalign 0.95
        yalign 0.95
        text_size 36
        text_color "#aaaaaa"
        text_hover_color "#ffffff"
        action Return("continue")


# ============================================
# ПЛАНШЕТ С ЗАДАНИЯМИ
# ============================================
# Картинку планшета положите в game/images/tablet.png (прозрачный PNG, примерно 1100x640).
# Пока файла нет, рисуется простая заглушка. Область текста подстраивается тремя числами ниже:
# отступ слева, отступ сверху и ширина текста — в пикселях внутри картинки планшета.

define tablet_image = "images/tablet.png"
define tablet_size = (1100, 640)
# По горизонтали планшет чуть сдвинут влево, чтобы не закрывать спрайт персонажа справа (0.5 = по центру).
define tablet_xalign = 0.3
define tablet_text_x = 130
define tablet_text_y = 100
define tablet_text_w = 840

screen tablet_tasks(title, items, bg=None):
    zorder 50

    fixed:
        xalign tablet_xalign
        yalign 0.25
        xysize tablet_size

        # bg — другая картинка вместо планшета (например, папка), по умолчанию tablet.png
        if renpy.loadable(bg or tablet_image):
            add (bg or tablet_image) fit "contain" xysize tablet_size
        else:
            add Solid("#23262b", xsize=tablet_size[0], ysize=tablet_size[1])
            add Solid("#eef1f4", xsize=tablet_size[0] - 80, ysize=tablet_size[1] - 80) pos (40, 40)

        vbox:
            xpos tablet_text_x
            ypos tablet_text_y
            xsize tablet_text_w
            spacing 24

            text title size 46 bold True color "#1b2a3a"

            for i, item in enumerate(items, 1):
                text "{}. {}".format(i, item) size 34 color "#222222"


label chapter_intro(num, title):
    scene black
    with fade
    $ result = renpy.call_screen("chapter_title", num, title)
    if result == "back":
        $ renpy.pop_call()
        jump chapter_select
    return


# ============================================
# МЕНЮ ВЫБОРА ГЛАВ
# ============================================

define chapter_names = [
    "Приёмное отделение",
    "Терапевтическое отделение",
    "Педиатрическое отделение",
    "Инфекционное отделение",
    "Психиатрическое отделение",
]

define ending_names = {
    "priem": "приёмное отделение",
    "therapy": "терапия",
    "pediatrics": "педиатрия",
    "infection": "инфекционное отделение",
    "psych": "психиатрия",
}

# Выбор главы. Оформление то же, что у обычных выборов (стиль choice).
# Закрытые главы видны, но недоступны, с подсказкой.
screen chapter_menu():
    style_prefix "choice"

    use api_player_info(40, 24, "#ffffff", "#cfcfcf")

    vbox:
        for n, name in enumerate(chapter_names, 1):
            $ prev_n = n - 1
            $ ending_text = ending_names.get(ending, "")
            if n > persistent.unlocked_chapters:
                textbutton "[n]. [name]\n{size=-9}откроется после главы [prev_n]{/size}" action None
            elif n == 5 and ending_text:
                textbutton "[n]. [name]\n{size=-9}Прошлая концовка: [ending_text]. Пройти главу заново{/size}" action Return(n)
            else:
                textbutton "[n]. [name]" action Return(n)

        textbutton "Пройти с главы 1\n{size=-9}(открытые главы сохранятся){/size}" action Return("restart")
        textbutton "Сменить игрока" action Return("switch")


label chapter_select:

    scene black
    with fade

    $ narrator("Выберите главу:", interact=False)
    call screen chapter_menu

    if _return == "switch":
        jump api_switch_player
    elif _return == "restart":
        jump start_game
    elif _return == 1:
        jump block1
    elif _return == 2:
        jump block2
    elif _return == 3:
        jump block3
    elif _return == 4:
        jump block4
    else:
        jump block5

label start_game:

    scene black
    with fade

    "Вы устраиваетесь на работу медбратом в городскую больницу."
    "Руководство решило дать вам возможность поработать в разных отделениях."

    jump block1


# Игра начинается здесь:
label start:
    $ _window_auto = False

    # Вход через сервер (api.rpy). Пустой ник не подменяем общим значением.
    call api_login_flow
    jump after_login

# Дальше после входа (в том числе после смены игрока из меню).
label after_login:

    # Если игрок заходит в первый раз — принудительно начинаем с начала
    if not persistent.game_started:
        $ persistent.game_started = True
        $ persistent.unlocked_chapters = 1
        call api_save
        jump start_game

    # Если уже играл раньше — показываем меню выбора
    jump chapter_select


# ============================================
# БЛОК 1. ПРИЁМНОЕ ОТДЕЛЕНИЕ
# ============================================

label block1:
    call chapter_intro(1, "Приёмное отделение")
    # Новое прохождение главы: обнуляем баллы и отношение (иначе сложатся с восстановленными с сервера)
    $ priem_score = 0
    $ priem_attitude = 0
    $ hidden_begin(1)

    scene priem
    with fade

    "7:30 утра."
    "Вы входите в приёмное отделение городской больницы."
    "Здесь шумно даже в такой ранний час: хлопают двери, скрипят каталки, кто-то на повышенных тонах спорит у регистратуры."

    "За стойкой стоит женщина лет тридцати пяти с собранными в тугой хвост волосами. На бейдже — Марина Андреевна."
    "Она бросает на вас быстрый взгляд, не отрываясь от телефона."

    $ show_char("marina")

    marina "Новенький? Отлично. Слушай внимательно, объяснять два раза некогда."
    marina "Приёмное — это лицо больницы. Люди приходят к нам в худший момент своей жизни. Испуганные, злые, больные. Всё сразу."

    "Она протягивает вам планшет."

    $ show_char("marina", "right", fade=False)
    show screen tablet_tasks("Задания на смену", [
        "Сортировка. Определить, кого принимать в первую очередь.",
        "Оформление пациента, который приехал на скорой без документов.",
        "Работа с родственниками. Они у нас бывают... эмоциональные.",
    ])
    with dissolve

    marina "Задания на смену — вот, читай."
    marina "Вопросы?"

    hide screen tablet_tasks
    $ show_char("marina", "center", fade=False)
    with dissolve

    menu:
        "Понял. Начинаю.":
            marina "Хорошо. Не стой, народ ждёт."
            $ priem_attitude = 1

        "А если я не пойму, кому хуже?":
            marina "Тогда зовёшь меня или дежурного врача. Лучше перебдеть. Главное — не гадать."
            $ priem_attitude = 1

        "Можно быть рядом с вами первое время?":
            marina "Первые полчаса — да. Дальше сам. Смотри, как я работаю."
            $ priem_attitude = 2

    # ======================================================
    # ЗАДАНИЕ 1. СОРТИРОВКА
    # ======================================================

    $ hide_char("marina")
    "В зале ожидания сидят четверо."
    "Пожилой мужчина с серым лицом держится за грудь и тяжело дышит."
    "Парень с перебинтованной ногой скучающе листает телефон."
    "Женщина средних лет с насморком недовольно смотрит на часы."
    "Девушка согнулась пополам, прижав руку к животу. Её тошнит."

    "Пожилой мужчина вдруг вытирает со лба пот и закрывает глаза."

    "Нужно быстро решить, в каком порядке принимать пациентов. Времени мало."

    call play_triage
    $ mg_note(1, "triage", triage_tier())

    if mg_red_ok and mg_correct >= 4:
        "Вы отмечаете мужчину с болью в груди красным и сразу зовёте дежурного врача."
        $ show_char("dmitri", 0.3, fade=False)
        $ show_char("marina", 0.7)
        marina "Правильно. Боль в груди, бледность, пот — это не ждёт."
        dmitri "Беру его. ЭКГ и анализы сразу, не ждём. Хорошо, что позвали сразу."
        "Мужчину быстро увозят на ЭКГ."
        $ hide_char("dmitri", fade=False)
        $ hide_char("marina")
        $ priem_score += 3

    elif mg_red_ok and mg_correct == 3:
        "Самого тяжёлого вы определили верно, и его сразу забирают на ЭКГ."
        "Только одного из остальных пришлось пересаживать."
        $ show_char("marina")
        marina "Хорошо. Главное ты увидел сразу. С остальными ещё потренируешься."
        $ priem_score += 2

    elif mg_red_ok:
        "Самого тяжёлого вы заметили. Остальных расставили не по порядку, и Марина Андреевна молча переставляет карточки."
        $ show_char("marina")
        marina "Главного не пропустил — это важно. Но в остальных путаешься. Смотри на жалобы и пульс вместе."
        $ priem_score += 1

    else:
        "Вы не успели поставить мужчину с болью в груди на первое место."
        "Марина Андреевна замечает, как он клонится вбок, и сама бросается к нему."
        $ show_char("marina")
        marina "Не по очереди! По тяжести! Запомни это раз и навсегда."
        $ priem_score -= 2

    # ======================================================
    # ЗАДАНИЕ 2. ПАЦИЕНТ БЕЗ ДОКУМЕНТОВ
    # ======================================================

    $ hide_char("marina")
    "Через некоторое время к дверям подъезжает скорая."
    "Фельдшер вводит пожилую женщину. Она растерянно оглядывается и крепко сжимает сумочку."

    $ show_char("patient_f", 0.25)
    patient_f "Где я? Мне сказали, что я упала на улице... Я ничего не помню."

    "У неё нет ни паспорта, ни полиса. Только имя на потёртой бумажке."

    menu:
        "Спокойно расспросить её, записать данные со слов и отметить, что документов нет":
            "Вы садитесь рядом и говорите медленно, тихо."
            "Женщина называет имя, возраст и адрес."
            $ show_char("patient_f", 0.25, fade=False)
            $ show_char("marina", 0.75)
            marina "Хорошо. Остальное доделаем потом. Помощь в приёмном не ждёт документов."
            $ priem_score += 2
            $ note(1, "good", "Приняли пациентку без документов, данные записали со слов", "Экстренного пациента принимают всегда, документы оформляют потом.", trust=5, confidence=3, flag="ch1_docs_ok")

        "Сказать, что без документов принять не получится":
            "Вы объясняете, что без паспорта оформить её не могут."
            "Женщина начинает плакать."
            $ show_char("patient_f", 0.25, fade=False)
            $ show_char("marina", 0.75)
            marina "Стоп! Так нельзя. Экстренного пациента принимают всегда. Документы — потом."
            $ priem_score -= 2
            $ note(1, "bad", "Отказали пациентке из-за отсутствия документов", "Экстренную помощь нельзя откладывать из-за бумаг.", trust=-7, confidence=-4, fatigue=2)

        "Позвать Марину Андреевну и уточнить, как оформлять такие случаи":
            "Вы коротко описываете ситуацию."
            $ show_char("patient_f", 0.25, fade=False)
            $ show_char("marina", 0.75)
            marina "Правильно, что спросил. Смотри: данные со слов, отметка в журнале, звонок в регистратуру."
            "Она быстро показывает порядок действий."
            $ priem_score += 1
            $ note(1, "ok", "Уточнили у наставницы порядок оформления", "Спросить правильно, но порядок стоит запомнить: данные со слов, отметка в журнале, звонок в регистратуру.", trust=2, confidence=1)

    # ======================================================
    # ЗАДАНИЕ 3. РОДСТВЕННИК
    # ======================================================

    $ hide_char("patient_f", fade=False)
    $ hide_char("marina")
    "Ближе к обеду у стойки возникает шум."
    "Крупный мужчина громко требует, чтобы его отца приняли немедленно."

    $ show_char("rodstvenic")
    relative "Мы уже сорок минут ждём! Вы тут вообще работаете?! Отец с давлением, а вы бумажки перекладываете!"

    "Люди в зале начинают оборачиваться."

    call play_deescalate("relative")
    $ mg_note(1, "relative", deesc_tier)
    $ mg_pts = deesc_points(3)

    if deesc_tier == "good":
        "Мужчина заметно остывает и опускает руки."
        relative "Ладно... Просто скажите, сколько ещё ждать."
        "Вы называете примерное время."

    elif deesc_tier == "mid":
        "Мужчина ещё хмурится, но голос стал тише."
        $ show_char("rodstvenic", 0.75, fade=False)
        $ show_char("marina", 0.25)
        marina "Я подойду. Хорошо, что не ответил на крик криком. Но разговор можно было вести увереннее."

    elif deesc_tier == "bad":
        "Мужчина так и не успокаивается."
        $ show_char("rodstvenic", 0.75, fade=False)
        $ show_char("marina", 0.25)
        marina "Тебе нужно учиться не отвечать агрессией на агрессию."

    else:
        "Мужчина срывается на крик. Вы нажимаете кнопку вызова."
        "Охранник приходит, но по залу уже летят громкие слова."
        $ show_char("rodstvenic", 0.75, fade=False)
        $ show_char("marina", 0.25)
        marina "Не всегда стоит сразу звать охрану. Сначала разговор. Но в этот раз хорошо, что подстраховался."

    $ priem_score += mg_pts

    # ======================================================
    # ФИНАЛ БЛОКА
    # ======================================================

    $ hide_char("rodstvenic", fade=False)
    $ hide_char("marina")
    "К двум часам дня поток людей немного спадает."
    "Вы возвращаете планшет на стойку."

    $ show_char("marina")
    marina "Так..."
    "Она быстро просматривает ваши отметки."

    if priem_score >= 6:
        marina "Хорошо поработал. Приоритеты расставил верно, с людьми говорил спокойно. Для первого дня — отлично."
    elif priem_score >= 3:
        marina "Нормально. Есть над чем подумать, но в целом справился."
    else:
        marina "Есть серьёзные замечания. В приёмном ошибка в сортировке может стоить человеку жизни."

    marina "На сегодня всё. Можешь быть свободен."
    marina "Завтра к восьми утра — в терапевтическое отделение. Там темп другой, но внимательность нужна та же."

    "Она кивает и уже поворачивается к новому пациенту."

    $ hide_char("marina")
    "Вы выходите на улицу."
    "Позади остаются звуки сирен и голоса людей, которым нужна помощь."

    "Первый день ротации закончен."

    call chapter_end(1, "Приёмное отделение")
    $ persistent.unlocked_chapters = max(persistent.unlocked_chapters, 2)
    call api_save
    jump block2


# ============================================
# БЛОК 2. ТЕРАПЕВТИЧЕСКОЕ ОТДЕЛЕНИЕ
# ============================================

label block2:
    call chapter_intro(2, "Терапевтическое отделение")
    # Новое прохождение главы: обнуляем баллы и отношение (иначе сложатся с восстановленными с сервера)
    $ therapy_score = 0
    $ therapy_attitude = 0
    $ hidden_begin(2)

    scene therapy
    with fade

    "Следующее утро."
    "Вы проходите через тяжёлую дверь терапевтического корпуса."
    "В нос сразу ударяет смешанный запах антисептика, варёной еды и чего-то кисловатого."

    "На сестринском посту сидит женщина лет сорока пяти. На бейдже — Ирина Валерьевна."
    "Она поднимает взгляд от журнала, когда вы подходите."

    $ show_char("irina")

    irina "Из приёмного к нам?"
    irina "Документы видела. Сегодня работаешь у меня."

    if "ch1_triage_missed" in story_flags:
        irina "Марина звонила. Говорит, в сортировке пришлось тебя поправлять. У нас спешка тоже ни к чему хорошему не приводит."
    elif "ch1_triage_ok" in story_flags:
        irina "Марина хвалила твою сортировку. Здесь так же: смотри на состояние человека, а не на очередь."

    "Она отодвигает стул и встаёт."

    irina "Запомни сразу: в терапии героизма мало, зато рутины — через край. Ошибки здесь незаметные, но от них люди дольше лежат."

    "Ирина Валерьевна протягивает вам планшет."

    $ show_char("irina", "right", fade=False)
    show screen tablet_tasks("Задания на смену", [
        "Измерить давление всем, кто в списке. Их шесть человек.",
        "Забор крови в палатах 3, 5 и 7.",
        "Помочь с утренней раздачей лекарств. Под моим контролем.",
    ])
    with dissolve

    irina "Задания на смену — вот, смотри."
    irina "Вопросы есть?"

    hide screen tablet_tasks
    $ show_char("irina", "center", fade=False)
    with dissolve

    menu:
        "Понял. Начинаю.":
            irina "Хорошо. Тогда иди. И не тяни время."
            $ therapy_attitude = 1

        "А если пациент откажется от процедуры?":
            irina "Тогда не уговариваешь по десять минут, а сразу зовёшь меня. Понял?"
            "Вы киваете."
            $ therapy_attitude = 1

        "Можно сначала уточнить, как правильно всё фиксировать в планшете?":
            irina "Можно."
            "Она быстро показывает интерфейс."
            irina "Здесь давление, здесь отметки о заборе крови, здесь примечания. Не выдумывай ничего от себя."
            $ therapy_attitude = 2

    # ======================================================
    # ЗАДАНИЕ 1. ИЗМЕРЕНИЕ ДАВЛЕНИЯ
    # ======================================================

    $ hide_char("irina")
    "Вы берёте тонометр и идёте по коридору."
    "Первые две палаты проходят относительно спокойно — пожилые люди привычно протягивают руки."

    "Третьим по списку оказывается пациент в палате №7."

    "Вы заходите."
    "Мужчина лет семидесяти восьми лежит поверх одеяла и смотрит в окно."

    patient "Опять мерить? Только не затягивай так, как та девчонка вчера. Рука потом полдня немела."

    "Вы надеваете манжету и запускаете тонометр."
    "Аппарат долго думает. На экране загораются цифры: 178 / 112."

    patient "Ну что там? Высокое, небось."

    $ timed(8)
    menu:
        "Сказать пациенту цифры и сразу пойти доложить старшей медсестре":
            "Вы спокойно называете цифры."
            patient "Ясно... Вечно оно скачет."
            "Вы выходите из палаты и направляетесь к посту."

            $ show_char("irina")
            irina "178 на 112?"
            "Она сразу тянется к телефону."
            irina "Хорошо, что не прошёл мимо. Вызываю лечащего."
            $ therapy_score += 2
            $ note(2, "good", "Назвали пациенту давление 178 на 112 и доложили старшей медсестре", "Критичные цифры нужно передавать сразу.", trust=3, confidence=3, flag="ch2_reported")

        "Сначала спросить, принимал ли он утренние лекарства":
            "Вы спрашиваете про таблетки."
            patient "Вроде пил... Или не пил. Честно говоря, уже не помню. Возраст."
            "Вы решаете не рисковать и идёте к Ирине Валерьевне."

            $ show_char("irina")
            irina "Правильно сделал. С такими цифрами лучше перестраховаться, чем потом объяснять, почему промолчал."
            $ therapy_score += 2
            $ note(2, "good", "Уточнили, принимал ли пациент утренние лекарства", "Это помогает понять причину скачка давления.", trust=3, confidence=4)

        "Просто записать результат в планшет и перейти к следующему пациенту":
            "Вы молча записываете цифры и выходите."
            "Через некоторое время из коридора доносится резкий голос Ирины Валерьевны."

            $ show_char("irina")
            irina "Эй! Иди сюда."
            "Она смотрит на вас тяжело."
            irina "Почему о давлении 178 на 112 мне никто не доложил? Ты вообще понимаешь, чем это может закончиться?"
            $ therapy_score -= 1
            $ note(2, "bad", "Записали давление 178 на 112 и не доложили", "Такие цифры нельзя оставлять без внимания.", trust=-4, confidence=-3, fatigue=2, flag="ch2_ignored_bp")

    # ======================================================
    # ЗАДАНИЕ 2. ЗАБОР КРОВИ
    # ======================================================

    $ hide_char("irina")
    "Следующее задание — забор крови."
    "Вы берёте нужные пробирки и идёте в палату №5."

    "Женщина примерно сорока лет сидит на краю кровати. Руки она держит между коленями и слегка раскачивается."

    patient_f "Вы... за анализами?"
    "Голос у неё слегка дрожит."
    patient_f "Я очень боюсь уколов. Можно как-нибудь... побыстрее? Или полегче?"

    menu:
        "Спокойно объяснить, что будет происходить, и сделать процедуру уверенно":
            "Вы говорите ровным голосом, объясняя каждый шаг."
            "Женщина всё равно вздрагивает, когда игла входит, но терпит."
            patient_f "Спасибо... Правда, почти не больно."
            $ therapy_score += 2
            $ note(2, "good", "Объяснили пациентке процедуру и уверенно взяли кровь", "Понятные шаги снижают страх перед уколом.", trust=4, confidence=4)

        "Попытаться отвлечь разговором":
            "Вы начинаете говорить о чём-то постороннем — о погоде, о том, как сложно парковаться возле больницы."
            "Пока пациентка отвечает, вы успеваете взять кровь."
            patient_f "Ой. А я даже не заметила, когда вы начали."
            $ therapy_score += 2
            $ note(2, "good", "Отвлекли пациентку разговором во время забора крови", "Отвлечение помогает, но объяснить шаги тоже важно.", trust=3, confidence=2)

        "Честно сказать, что лучше позвать более опытного сотрудника":
            "Вы выходите из палаты и подходите к посту."
            $ show_char("irina")
            irina "Боится?"
            "Она вздыхает, берёт перчатки и идёт с вами."
            irina "В этот раз помогу. Но учиться всё равно придётся. Не всегда будет кому тебя подстраховать."
            $ therapy_score += 0
            $ note(2, "ok", "Попросили более опытного коллегу взять кровь", "Честность хороша, но простую процедуру стоит уметь делать самому.", trust=1, confidence=-3)

    # ======================================================
    # ЗАДАНИЕ 3. РАЗДАЧА ЛЕКАРСТВ
    # ======================================================

    $ hide_char("irina")
    "Ближе к половине десятого Ирина Валерьевна подзывает вас."

    $ show_char("irina")
    irina "Теперь лекарства. Смотри внимательно."
    irina "Ты называешь фамилию, я проверяю, потом отдаём. Никакой самодеятельности."

    "Вы встаёте рядом с тележкой."

    "Первые несколько пациентов проходят без проблем."
    "На одном из пунктов вы замечаете, что в списке и на упаковке препарата названия чуть отличаются."

    $ timed(9)
    menu:
        "Остановить раздачу и уточнить у Ирины Валерьевны":
            "Вы показываете ей упаковку и список."
            irina "Хорошо, что заметил. Это одинаковые действующие вещества, разные производители. Можно давать."
            "Она ставит галочку."
            irina "Внимательность — это хорошо."
            $ therapy_score += 2
            $ note(2, "good", "Остановили раздачу лекарств из-за расхождения в названии", "Сверка списка с упаковкой основа безопасности пациента.", trust=2, confidence=4, flag="ch2_asked_irina")

        "Решить, что разница несущественная, и отдать лекарство":
            "Вы отдаёте препарат."
            "Ирина Валерьевна через минуту останавливает вас."
            irina "Стой. Почему не уточнил? В следующий раз сначала спрашивай, потом действуй."
            $ therapy_score -= 1
            $ note(2, "bad", "Выдали лекарство, решив, что разница в названии несущественная", "Заменять препарат самостоятельно нельзя.", trust=-3, confidence=-4, fatigue=2, flag="ch2_guessed_meds")

        "Пропустить этого пациента и вернуться к нему позже":
            "Вы решаете пока обойти сложный момент."
            irina "Почему одного человека пропустил?"
            "Приходится объяснять."
            irina "В следующий раз сразу говори. Не надо ничего откладывать."
            $ therapy_score += 0
            $ note(2, "ok", "Пропустили пациента, у которого название не совпало", "Пропустить лучше, чем ошибиться, но вопрос стоило решить сразу.", trust=-1, confidence=-1)

    # ======================================================
    # ФИНАЛ БЛОКА
    # ======================================================

    "К двенадцати часам основные задания выполнены."
    "Вы возвращаете планшет на пост."

    irina "Так..."
    "Она быстро просматривает отметки."

    if therapy_score >= 5:
        irina "Нормально отработал. Без критических ошибок. Достойно."
    elif therapy_score >= 3:
        irina "Приемлемо. Есть моменты, над которыми стоит подумать, но в целом справился."
    else:
        irina "Есть серьёзные замечания. Завтра будь заметно внимательнее."

    irina "На сегодня всё. Можешь быть свободен."
    irina "Завтра к восьми утра жду тебя уже в педиатрическом отделении. Там будет сложнее."

    "Она снова уткнулась в бумаги, показывая, что разговор окончен."

    $ hide_char("irina")
    "Вы выходите в коридор."
    "За спиной остаётся запах антисептика и тихий голос телевизора из одной из палат."

    "Второй день ротации закончен."

    call chapter_end(2, "Терапевтическое отделение")
    $ persistent.unlocked_chapters = max(persistent.unlocked_chapters, 3)
    call api_save
    jump block3


# ============================================
# БЛОК 3. ПЕДИАТРИЧЕСКОЕ ОТДЕЛЕНИЕ
# ============================================

label block3:
    call chapter_intro(3, "Педиатрическое отделение")
    # Новое прохождение главы: обнуляем баллы и отношение (иначе сложатся с восстановленными с сервера)
    $ pediatrics_score = 0
    $ pediatrics_attitude = 0
    $ hidden_begin(3)

    scene pediatrics
    with fade

    "Утро третьего дня."
    "Вы входите в педиатрический корпус."
    "Здесь совсем другая атмосфера: яркие стены, рисунки, запах детского шампуня, смешанный с антисептиком."
    "Где-то в глубине коридора плачет ребёнок."

    "На посту сидит женщина с усталым, но внимательным взглядом. На бейдже — Надежда Сергеевна."

    $ show_char("nadezhda")

    nadezhda "Ты из терапии, да?"
    nadezhda "Хорошо. Слушай внимательно."

    if "ch2_guessed_meds" in story_flags:
        nadezhda "Ирина Валерьевна передала: с лекарствами ты поспешил. У нас дозы считают по весу, так что сверяй дважды."
    elif "ch2_asked_irina" in story_flags:
        nadezhda "Ирина Валерьевна сказала, что ты сверяешь названия. У нас это важнее вдвойне."

    nadezhda "Здесь работают не только с детьми. Здесь работают ещё и с родителями. Иногда родители сложнее."

    "Она протягивает вам планшет."

    $ show_char("nadezhda", "right", fade=False)
    show screen tablet_tasks("Задания на сегодня", [
        "Измерить температуру и провести осмотр у троих детей.",
        "Помочь поставить периферический катетер ребёнку 6 лет.",
        "Подготовить к процедуре одного очень испуганного ребёнка.",
    ])
    with dissolve

    nadezhda "Задания на сегодня — вот."
    nadezhda "Главное правило — не повышать голос и не обманывать. Дети это чувствуют."

    hide screen tablet_tasks
    $ show_char("nadezhda", "center", fade=False)
    with dissolve

    menu:
        "Понял. Начинаю.":
            nadezhda "Тогда вперёд. Первая палата по списку."
            $ pediatrics_attitude = 1

        "А если ребёнок начнёт сильно истерить?":
            nadezhda "Сначала пытаешься успокоить. Если совсем плохо — зовёшь меня. Силой ничего не делаем."
            $ pediatrics_attitude = 1

        "Можно немного подробнее про катетер? Я пока мало практиковался.":
            nadezhda "Хорошо, что сказал. Буду рядом и подстрахую. Но руки всё равно твои."
            $ pediatrics_attitude = 2

    # ======================================================
    # ЗАДАНИЕ 1. ИСПУГАННЫЙ РЕБЁНОК
    # ======================================================

    $ hide_char("nadezhda")
    "Вы подходите к палате, из которой слышен плач."
    "На кровати сидит девочка примерно пяти лет. Она изо всех сил прижимает к себе плюшевого зайца и смотрит на вас широко открытыми глазами."

    $ show_char("child_girl")
    child "Не надо! Не буду! Больно!"

    "Рядом стоит мама. Вид у неё измученный."

    $ show_char("child_girl", 0.3, fade=False)
    $ show_char("mama", 0.7)
    mother "Мы уже второй день не можем нормально сдать анализы... Она очень боится."

    menu:
        "Предложить девочке сначала «полечить» её зайца":
            "Вы присаживаетесь на корточки, чтобы быть на одном уровне с ребёнком."
            "Говорите спокойно и предлагаете вместе посмотреть, что болит у зайца."

            child "У него... у него лапка болит."
            "Вы серьёзно осматриваете игрушку, «обрабатываете» лапку и аккуратно заклеиваете пластырем."

            "Через несколько минут девочка уже соглашается показать свою руку."
            mother "Спасибо вам... Правда."
            $ pediatrics_score += 3
            $ note(3, "good", "Предложили девочке сначала «полечить» её зайца", "Игра снимает страх лучше уговоров.", trust=6, confidence=4, flag="ch3_rabbit")

        "Спокойно объяснить, что будет быстро и нестрашно":
            "Вы говорите ровным голосом, без сюсюканья."
            "Девочка всё равно плачет, но позволяет провести процедуру."
            "Мама помогает держать руку."
            $ pediatrics_score += 1
            $ note(3, "ok", "Объяснили девочке, что будет быстро и нестрашно", "Верно, но ребёнку нужна игра, а не только объяснение.", trust=2, confidence=1)

        "Попросить маму выйти из палаты, чтобы ребёнок меньше капризничал":
            "Мама неуверенно выходит."
            "Как только дверь закрывается, девочка начинает кричать гораздо сильнее."
            "Приходится возвращать маму обратно."
            $ show_char("child_girl", 0.42, fade=False)
            $ show_char("mama", 0.75, fade=False)
            $ show_char("nadezhda", 0.12)
            nadezhda "В следующий раз так не делай. Родители здесь часто помогают, а не мешают."
            $ pediatrics_score -= 1
            $ note(3, "bad", "Попросили маму выйти из палаты", "Присутствие родителя успокаивает ребёнка.", trust=-6, confidence=-2, fatigue=2)

    # ======================================================
    # ЗАДАНИЕ 2. УСТАНОВКА КАТЕТЕРА
    # ======================================================

    $ hide_char("child_girl", fade=False)
    $ hide_char("mama", fade=False)
    $ hide_char("nadezhda")
    "Следующий пациент — мальчик 6 лет после операции."
    "Ему нужно поставить периферический катетер."

    $ show_char("child", 0.45, fade=False)
    $ show_char("mama", 0.78)
    "Надежда Сергеевна подходит и встаёт рядом."

    $ show_char("nadezhda", 0.13)
    nadezhda "Я рядом. Работаешь ты. Не торопись."

    "Мальчик лежит и крепко держит маму за руку. Глаза испуганные."

    child "Можно... можно я не буду?"

    menu:
        "Спокойно объяснить, зачем нужна процедура, и начать работу":
            "Вы говорите коротко и по делу."
            "Руки слегка дрожат, но вы справляетесь."
            "Катетер встаёт нормально."
            nadezhda "Приемлемо. В следующий раз будет увереннее."
            $ pediatrics_score += 2
            $ note(3, "good", "Объяснили мальчику, зачем нужна процедура", "Понимание цели снижает тревогу.", trust=3, confidence=3)

        "Честно признаться Надежде Сергеевне, что сильно волнуетесь":
            nadezhda "Хорошо, что сказал."
            "Она встаёт чуть ближе и тихо направляет ваши действия."
            "Вместе вы ставите катетер без проблем."
            nadezhda "Волноваться нормально. Главное — не молчать, когда не уверен."
            $ pediatrics_score += 2
            $ note(3, "good", "Признались наставнице, что сильно волнуетесь", "Честность перед наставником безопаснее, чем скрытая тревога.", trust=1, confidence=3, flag="ch3_honest")

        "Попросить мальчика очень крепко держаться за маму и отвлечь его разговором":
            "Вы начинаете спрашивать его про мультики, пока готовите всё необходимое."
            "В момент прокола он вздрагивает, но катетер встаёт."
            $ pediatrics_score += 1
            $ note(3, "ok", "Попросили мальчика держаться за маму и отвлекли разговором", "Отвлечение работает, но объяснить суть тоже важно.", trust=2, confidence=1)

    # ======================================================
    # ЗАДАНИЕ 3. ОТКАЗ ОТ ЛЕКАРСТВА
    # ======================================================

    $ hide_char("child", fade=False)
    $ hide_char("mama", fade=False)
    $ hide_char("nadezhda")
    "Ближе к обеду один из детей наотрез отказывается пить лекарство."

    "Мальчик лет семи плотно сжимает губы и отворачивается к стене."

    $ show_char("child", 0.42)
    child "Не буду. Оно гадкое."

    $ show_char("mama", 0.75)
    mother "Мы уже полчаса уговариваем..."

    menu:
        "Предложить выпить через трубочку и сильно похвалить заранее":
            "Вы приносите трубочку и говорите, что он точно справится."
            "После небольшой паузы мальчик соглашается."
            "Лекарство выпито."
            $ pediatrics_score += 2
            $ note(3, "good", "Предложили выпить лекарство через трубочку и похвалили заранее", "Мотивация работает лучше давления.", trust=4, confidence=3)

        "Строго объяснить, что лекарство необходимо, и настоять":
            "Вы говорите серьёзным тоном."
            "Ребёнок начинает плакать, но под давлением мамы всё-таки выпивает."
            $ show_char("nadezhda", 0.13)
            nadezhda "Сработало. Но в следующий раз попробуй мягче. Здесь на страхе долго не выедешь."
            $ pediatrics_score += 0
            $ note(3, "ok", "Строго настояли на приёме лекарства", "Давление пугает ребёнка, сначала нужна мотивация.", trust=-3, fatigue=1)

        "Позвать Надежду Сергеевну":
            "Вы решаете не давить сами."
            $ show_char("nadezhda", 0.13)
            nadezhda "Ладно, в этот раз я. Смотри, как делаю."
            "Она за пару минут уговаривает ребёнка без криков."
            $ pediatrics_score += 0
            $ note(3, "ok", "Позвали наставницу, когда ребёнок отказался пить лекарство", "Помощь не провал, но этот случай по силам решить самому.", confidence=-2)

    # ======================================================
    # ФИНАЛ БЛОКА
    # ======================================================

    $ hide_char("child", fade=False)
    $ hide_char("mama", fade=False)
    $ hide_char("nadezhda")
    "К концу смены в отделении становится чуть тише."
    "Вы возвращаете планшет на пост."

    $ show_char("nadezhda")
    nadezhda "Так..."

    if pediatrics_score >= 6:
        nadezhda "Хорошо поработал. Особенно с маленькой девочкой. Чувствуется, что не просто отбываешь смену."
    elif pediatrics_score >= 3:
        nadezhda "Нормально. Не без замечаний, но для первого дня в педиатрии — достойно."
    else:
        nadezhda "Есть над чем работать. Здесь важно не только уметь ставить катетеры, но и находить подход."

    nadezhda "На сегодня всё."
    nadezhda "Завтра у тебя инфекционное отделение. Там уже другие правила — про дисциплину и осторожность."

    "Она коротко кивает и возвращается к своим записям."

    $ hide_char("nadezhda")
    "Вы выходите из педиатрического отделения."
    "За спиной остаётся приглушённый детский плач и чей-то смех из игровой комнаты."

    "Третий день ротации закончен."

    call chapter_end(3, "Педиатрическое отделение")
    $ persistent.unlocked_chapters = max(persistent.unlocked_chapters, 4)
    call api_save
    jump block4


# ============================================
# БЛОК 4. ИНФЕКЦИОННОЕ ОТДЕЛЕНИЕ
# ============================================

label block4:
    call chapter_intro(4, "Инфекционное отделение")
    # Новое прохождение главы: обнуляем баллы и отношение (иначе сложатся с восстановленными с сервера)
    $ infection_score = 0
    $ infection_attitude = 0
    $ hidden_begin(4)
    $ ppe_infected = False

    scene infection
    with fade

    "Утро четвёртого дня."
    "Вы подходите к инфекционному корпусу."
    "Уже на входе висят предупреждающие таблички. Двери здесь плотнее, а воздух будто тяжелее."

    "В шлюзе вас встречает женщина в возрасте. Движения у неё чёткие, голос спокойный, но жёсткий. На бейдже — Ольга Николаевна."

    $ show_char("olga")

    olga "Ты из ротации?"
    olga "Хорошо. Здесь правила простые: нарушил протокол — можешь не только сам заразиться, но и других подставить."

    if "ch3_honest" in story_flags:
        olga "Надежда Сергеевна говорит, ты не боишься признаться, что волнуешься. Это ценно. Протокол гордости не терпит."

    "Она смотрит на вас внимательно."

    $ show_char("olga", "right", fade=False)
    show screen tablet_tasks("Задания на смену", [
        "Правильно надеть полный комплект СИЗ.",
        "Провести забор анализов у пациента в боксе.",
        "Объяснить родственникам через стекло, почему нельзя заходить к пациенту.",
    ])
    with dissolve

    olga "Задания на смену — вот, смотри."
    olga "Вопросы есть?"

    hide screen tablet_tasks
    $ show_char("olga", "center", fade=False)
    with dissolve

    menu:
        "Понял. Готов.":
            olga "Тогда начинаем с переодевания."
            $ infection_attitude = 1

        "А если СИЗ будет очень жарко и неудобно?":
            olga "Будет. Терпишь. Снимать ничего нельзя, пока не выйдешь через правильную зону."
            $ infection_attitude = 1

        "Я первый раз в полном комплекте. Можно проверить меня после надевания?":
            olga "Можно и нужно. Лучше лишний раз проверить, чем потом иметь проблемы."
            $ infection_attitude = 2

    # ======================================================
    # ЗАДАНИЕ 1. НАДЕВАНИЕ СИЗ
    # ======================================================

    "Вы заходите в комнату, где разложены защитные костюмы, очки, респираторы и перчатки."

    olga "Надеваешь всё по порядку. Я смотрю."
    olga "Порядок такой: костюм, респиратор, очки, перчатки. Запомни его. Снимать будешь в обратном."

    "Костюм оказывается тесным. Респиратор давит. Очки почти сразу начинают запотевать."

    call play_ppe("don")
    $ mg_note(4, "ppe_don", ppe_tier())

    if ppe_errors == 0:
        "Вы фиксируете каждый элемент в правильном порядке. Ольга Николаевна проверяет швы и кивает."
        olga "Нормально. Можно работать."
        $ infection_score += 3

    elif ppe_errors == 1:
        "Вы путаетесь на одном из элементов. Ольга Николаевна останавливает вас за плечо."
        olga "Стоп. Вот здесь нарушен порядок. Поправь."
        "Приходится переделывать часть комплекта."
        $ infection_score += 2

    else:
        $ ppe_infected = True
        "Вы торопитесь и путаете порядок. Ольга Николаевна останавливает вас за плечо."
        olga "Стоп. Ты уже коснулся грязной стороны. В настоящем боксе ты бы заразился."
        "Приходится начинать почти заново."
        $ infection_score -= 1

    # ======================================================
    # ЗАДАНИЕ 2. РАБОТА В БОКСЕ
    # ======================================================

    $ hide_char("olga")
    "Вы проходите в бокс."
    "На кровати лежит молодой парень. Температура высокая, вид уставший и слегка растерянный."

    $ show_char("pac_alec")
    patient "Вы тоже... в этой броне."
    "Голос у него слабый."
    patient "Страшно выглядите, если честно."

    "Вам нужно взять кровь на анализы."

    menu:
        "Спокойно объяснить, зачем нужна защита, и провести процедуру":
            "Вы говорите ровно, без лишних эмоций."
            "Парень кивает и отводит взгляд."
            "Забор крови проходит без осложнений."
            $ infection_score += 2
            $ note(4, "good", "Объяснили пациенту, зачем нужна защита, и провели процедуру", "Объяснение снижает страх в боксе.", trust=4, confidence=3)

        "Сосредоточиться только на процедуре и почти не разговаривать":
            "Вы работаете быстро и молча."
            "Пациент напрягается сильнее, но процедуру удаётся закончить."
            $ infection_score += 1
            $ note(4, "ok", "Провели процедуру, почти не разговаривая с пациентом", "Безопасно, но молчание пугает человека в боксе.", trust=-1, confidence=1)

        "Попытаться разговорить пациента, чтобы снять напряжение":
            "Вы коротко спрашиваете, как он себя чувствует, и объясняете, что сейчас будет."
            "Парень немного расслабляется."
            "Кровь удаётся взять спокойно."
            $ infection_score += 2
            $ note(4, "ok", "Разговорили пациента, чтобы снять напряжение", "Контакт важен, главное не забывать о протоколе.", trust=3, confidence=1)

    # ======================================================
    # ЗАДАНИЕ 3. РАЗГОВОР С РОДСТВЕННИКАМИ
    # ======================================================

    $ hide_char("pac_alec")
    "Когда вы выходите из бокса в чистую зону, у стеклянной перегородки уже стоит женщина."
    "Она заметно взволнована и стучит по стеклу."

    $ show_char("mama")
    mother "Почему нельзя зайти?! Я же мать! Он один там лежит!"

    "За стеклом её почти не слышно, но по губам и жестам всё понятно."

    call play_deescalate("mother")
    $ mg_note(4, "mother", deesc_tier)
    $ mg_pts = deesc_points(3)

    if deesc_tier == "good":
        "Женщина всё ещё расстроена, но перестаёт кричать и просит позвать врача."
    elif deesc_tier == "mid":
        "Напряжение немного спадает, но женщина всё ещё стучит по стеклу."
    elif deesc_tier == "bad":
        "Женщина стучит всё сильнее. Ситуацию приходится разруливать Ольге Николаевне."
        $ show_char("mama", 0.75, fade=False)
        $ show_char("olga", 0.22)
        olga "В следующий раз не оставляй людей в таком состоянии. Объяснять тоже часть работы."
    else:
        "Женщина срывается на крик и бьёт по стеклу."
        $ show_char("mama", 0.75, fade=False)
        $ show_char("olga", 0.22)
        olga "Стоп. Дальше я сама. В следующий раз не доводи до этого. Объяснять тоже часть работы."

    $ infection_score += mg_pts

    # ======================================================
    # ФИНАЛ БЛОКА
    # ======================================================

    $ hide_char("mama", fade=False)
    $ hide_char("olga")
    "К концу смены нужно выйти через шлюз и снять СИЗ."
    "Ольга Николаевна ничего не подсказывает. Она просто смотрит."

    call play_ppe("doff")
    $ mg_note(4, "ppe_doff", ppe_tier())

    if ppe_errors == 0:
        "Вы снимаете комплект без единой ошибки."
        $ infection_score += 1
    elif ppe_errors == 1:
        "Вы на секунду путаетесь, но успеваете остановиться."
    else:
        $ ppe_infected = True
        "Вы неправильно снимаете комплект и касаетесь заражённой стороны."
        $ infection_score -= 1

    "Под костюмом всё мокрое от пота."

    $ show_char("olga")
    "Ольга Николаевна ждёт вас уже без маски."

    olga "Так..."

    if infection_score >= 7:
        olga "Хорошо. Особенно то, как с родственницей поговорил. Многие здесь начинают нервничать и давить."
    elif infection_score >= 4:
        olga "Приемлемо. Протокол в основном выдержал. Это главное."
    else:
        olga "Есть нарушения. В инфекционке за такое быстро перестают пускать в боксы."

    if ppe_infected:
        olga "И ещё. С СИЗ ты ошибся так, что в настоящем отделении тебя бы уже изолировали. Повтори протокол."

    olga "На сегодня всё."
    olga "Завтра последний день ротации — психиатрическое отделение. Там уже совсем другая нагрузка. Не на руки, а на голову."

    "Она коротко кивает и уходит."

    $ hide_char("olga")
    "Вы выходите из инфекционного корпуса."
    "Даже обычный воздух после полного комплекта СИЗ кажется необычно лёгким."

    "Четвёртый день ротации закончен."

    call chapter_end(4, "Инфекционное отделение")
    $ persistent.unlocked_chapters = max(persistent.unlocked_chapters, 5)
    call api_save
    jump block5


# ============================================
# БЛОК 5. ПСИХИАТРИЧЕСКОЕ ОТДЕЛЕНИЕ
# ============================================

label block5:
    call chapter_intro(5, "Психиатрическое отделение")
    # Новое прохождение главы: обнуляем баллы и отношение (иначе сложатся с восстановленными с сервера)
    $ psych_score = 0
    $ psych_attitude = 0
    $ hidden_begin(5)

    scene psych
    with fade

    "Последний день ротации."
    "Вы подходите к психиатрическому корпусу."
    "Здание кажется обычным... слишком обычным."

    "Внутри тихо."
    "Слишком тихо."

    "На посту сидит женщина с очень спокойным, почти пустым взглядом. На бейдже — Елена Викторовна."

    $ show_char("elena")

    elena "Ты новенький."
    elena "Здесь главное — не бояться тишины. И не верить всему, что услышишь."

    if "ch4_ppe_fail" in story_flags:
        elena "Ольга Николаевна предупреждала: с протоколом у тебя были осечки. У нас другие правила, но внимательность нужна та же."

    "Она протягивает вам тонкую папку."

    # Здесь персонаж даёт папку: можно положить картинку game/images/folder.png, иначе будет нейтральная рамка
    $ show_char("elena", "right", fade=False)
    show screen tablet_tasks("Задания на смену", [
        "Провести наблюдение за пациентом с острым состоянием.",
        "Убедить пациентку принять препараты.",
        "Корректно отреагировать, если ситуация начнёт выходить из-под контроля.",
    ], bg="images/folder.png")
    with dissolve

    elena "Задания на смену — в папке."
    elena "И ещё..."
    elena "Если услышишь крик — не беги сразу. Сначала думай."

    hide screen tablet_tasks
    $ show_char("elena", "center", fade=False)
    with dissolve

    menu:
        "Понял.":
            elena "Тогда начинай. Палата в конце коридора."
            $ psych_attitude = 1

        "А если станет по-настоящему опасно?":
            elena "Тогда жмёшь тревожную кнопку. Не геройствуй."
            $ psych_attitude = 1

        "Я могу задавать вопросы пациентам?":
            elena "Можно. Только не спорь с ними о реальности. Это бесполезно и опасно."
            $ psych_attitude = 2

    # ======================================================
    # ЗАДАНИЕ 1. НАБЛЮДЕНИЕ
    # ======================================================

    $ hide_char("elena")
    "Вы идёте по длинному коридору."
    "Лампы гудят. Одна из них слегка мерцает."

    "Вдруг откуда-то сверху доносится глухой звук."

    "Словно что-то тяжёлое ударилось о стену."

    pause 1.0

    "Вы останавливаетесь."

    "Тишина возвращается."

    "В палате №4 сидит мужчина. Он раскачивается вперёд-назад и что-то шепчет."

    $ show_char("pac_alec")
    patient "Они заменили врачей..."
    patient "Теперь здесь ходят только они..."

    "Он резко поднимает голову и смотрит прямо на вас."

    patient "Ты тоже один из них, да?"

    call play_deescalate("psych")
    $ mg_note(5, "psych", deesc_tier)
    $ mg_pts = deesc_points(2)

    if deesc_tier == "good":
        "Он несколько секунд молчит, потом снова начинает раскачиваться, но уже спокойнее."
    elif deesc_tier == "mid":
        "Он продолжает шептать, но уже тише."
    elif deesc_tier == "bad":
        "Он замолкает, но смотрит на вас всё так же настороженно."
    else:
        patient "ЛЖЁШЬ!" with vpunch
        patient "ВЫ ВСЕ ЛЖЁТЕ!!!" with hpunch
        "Дверь палаты открывается. Входит санитар, следом — Елена Викторовна."
        $ show_char("pac_alec", 0.75, fade=False)
        $ show_char("elena", 0.22)
        elena "В следующий раз не спорь с бредом. Запомнил?"

    $ psych_score += mg_pts

    # ======================================================
    # РЕЗКИЙ ХОРРОР-МОМЕНТ
    # ======================================================

    $ hide_char("pac_alec", fade=False)
    $ hide_char("elena")
    "Вы выходите из палаты."

    "В коридоре на стуле сидит женщина лет пятидесяти и нервно теребит край кофты."

    $ show_char("mama_50")
    mother "Вы были у Алексея? Он опять говорил, что врачей подменили?"
    mother "Раньше он таким не был. Скажите хотя бы... он нас узнаёт?"

    "Вы не знаете, что ответить. Она медленно кивает, будто всё поняла сама, и прикрывает рот ладонью."

    $ hide_char("mama_50")

    "Коридор кажется длиннее, чем раньше."

    pause 1.2

    "Вдруг откуда-то слева раздаётся пронзительный женский крик."

    "АААААААААААААА!!!" with hpunch

    pause 0.8

    "Крик обрывается так же внезапно, как начался."

    "Вы замираете."

    $ timed(6)
    menu:
        "Пойти на звук":
            "Вы быстро идёте в сторону, откуда доносился крик."
            "Одна из дверей приоткрыта."
            "Внутри пустая палата. Только смятая постель и опрокинутый стул."
            "Никого."
            $ psych_score += 1
            $ note(5, "ok", "Пошли на крик в одиночку", "Идти одному рискованно: сначала сообщите на пост.", confidence=2, fatigue=2, tension=10)

        "Остаться на месте и сообщить на пост":
            "Вы возвращаетесь к посту и докладываете."
            $ show_char("elena")
            elena "Проверим. Иногда здесь бывает... шумно."
            "Она говорит это слишком спокойно."
            $ psych_score += 1
            $ note(5, "good", "Остались на месте и сообщили на пост", "Правильный порядок действий при тревоге.", trust=2, confidence=3, tension=2, flag="ch5_reported")

        "Сделать вид, что ничего не слышал":
            "Вы продолжаете идти как ни в чём не бывало."
            "Но спина становится мокрой от холодного пота."
            $ psych_score += 0
            $ note(5, "bad", "Сделали вид, что не слышали крика", "Игнорировать тревожный сигнал нельзя.", trust=-3, confidence=-4, fatigue=2, tension=15, flag="ch5_ignored")

    # ======================================================
    # ЗАДАНИЕ 2. ПРИЁМ ЛЕКАРСТВ
    # ======================================================

    $ hide_char("elena")
    "Следующая пациентка сидит на кровати и смотрит в одну точку."

    $ show_char("patient_f")
    patient_f "Это не лекарство."
    patient_f "Это яд. Они хотят, чтобы я заснула и больше не проснулась."

    "Перед ней на тумбочке стоят стакан воды и два блистера."

    $ timed(10)
    menu:
        "Спокойно объяснить, зачем нужны препараты, и предложить выпить при вас":
            "Вы садитесь чуть в стороне (не напротив) и говорите тихо."
            "Дыхание у неё частое и рваное. Вы предлагаете дышать вместе, в одном ритме."

            call play_breathing
            $ mg_note(5, "breathing", br_tier())

            if br_score >= 6:
                "Плечи пациентки опускаются. Долгое молчание."
                patient_f "...Хорошо. Но вы останетесь."
                "Она выпивает таблетки."
                $ psych_score += 3
            elif br_score >= 4:
                "Дыхание немного выравнивается, но пальцы всё ещё сжаты."
                patient_f "Я выпью. Только не отходите."
                "Она неохотно выпивает таблетки."
                $ psych_score += 2
            else:
                "Ритм сбился, и она отворачивается к стене."
                "Вы тихо вызываете Елену Викторовну."
                $ show_char("patient_f", 0.75, fade=False)
                $ show_char("elena", 0.22)
                elena "Иногда это единственный нормальный вариант."
                "Она заходит и через несколько минут справляется."
                $ psych_score += 1

        "Сказать, что это назначение врача, и настоять":
            "Вы повышаете голос чуть сильнее, чем нужно."

            patient_f "НЕ НАДО!!!" with vpunch

            "Она отшвыривает стакан. Вода разливается по полу."
            "Приходится вызывать дежурного врача."
            $ show_char("patient_f", 0.75, fade=False)
            $ show_char("sergey", 0.22)
            sergey "Так, давайте без крика. Я рядом, сейчас всё спокойно обсудим."
            $ psych_score -= 1
            $ note(5, "bad", "Настояли на приёме препарата, повысив голос", "Давление и крик усиливают тревогу пациентки.", trust=-6, confidence=-3, fatigue=2, tension=12)

        "Сразу позвать Елену Викторовну":
            "Вы решаете не давить сами."
            $ show_char("patient_f", 0.75, fade=False)
            $ show_char("elena", 0.22)
            elena "Иногда это единственный нормальный вариант."
            "Она заходит и через несколько минут справляется."
            $ psych_score += 1
            $ note(5, "ok", "Сразу позвали Елену Викторовну", "Помощь старшей не слабость, но стоило сначала попробовать мягче.", confidence=-2, tension=3)

    # ======================================================
    # ФИНАЛЬНЫЙ НАПРЯЖЁННЫЙ МОМЕНТ
    # ======================================================

    $ hide_char("patient_f", fade=False)
    $ hide_char("sergey", fade=False)
    $ hide_char("elena")
    "Ближе к вечеру, когда вы уже собираетесь сдавать смену..."

    "В коридоре внезапно гаснет свет."

    pause 1.0

    "На несколько секунд становится абсолютно темно."

    "А потом лампы вспыхивают снова."

    "В дальнем конце коридора кто-то стоит."

    "Слишком неподвижно."

    pause 0.8

    "Вы моргаете — и человека уже нет."

    if phantom_ready():
        "Вы так вымотаны, что уже не уверены: был ли он вообще."

    # ======================================================
    # ФИНАЛЬНЫЙ ВЫБОР + КОНЦОВКА
    # ======================================================

    "Елена Викторовна подходит к вам, когда вы возвращаетесь на пост."

    elena "Смена закончена."
    elena "Ты прошёл все отделения."

    "Она смотрит на вас чуть дольше, чем нужно."

    elena "Теперь важный вопрос."
    elena "Где ты себя видишь дальше?"

    menu:
        "В приёмном — люблю быстрый темп и работу с людьми":
            $ ending = "priem"

        "В терапии — стабильная и системная работа":
            $ ending = "therapy"

        "В педиатрии — хочу работать с детьми":
            $ ending = "pediatrics"

        "В инфекционном — ценю дисциплину и протоколы":
            $ ending = "infection"

        "В психиатрии — здесь нужна настоящая устойчивость":
            $ ending = "psych"

    call chapter_end(5, "Психиатрическое отделение")

